[Unit]
Description=Apply NARA entry settings and verified panel updates
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/nara-panel
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/nara-panel/.venv/bin/python -m nara.access apply
TimeoutStartSec=1200
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=true
ReadWritePaths=/usr/local/bin
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
