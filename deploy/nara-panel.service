[Unit]
Description=NARA Sing-box server panel
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=nara-panel
Group=nara-panel
WorkingDirectory=/opt/nara-panel
Environment=NARA_DATA=/var/lib/nara-panel
Environment=NARA_CORE=/opt/nara-panel/bin/sing-box
Environment=NARA_BIND=0.0.0.0
Environment=NARA_PORT=10000
Environment=PYTHONDONTWRITEBYTECODE=1
EnvironmentFile=-/etc/nara-panel.env
ExecStart=/opt/nara-panel/.venv/bin/python -m nara serve
Restart=on-failure
RestartSec=5
TimeoutStopSec=45
KillMode=control-group
UMask=0077
StateDirectory=nara-panel
StateDirectoryMode=0700
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nara-panel
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
